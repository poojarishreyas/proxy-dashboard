# Copy to .env.local for local development (`npm run dev`), or set these as
# Environment Variables in the Vercel project for a real deployment.

# From Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# A random secret only the shrey CLI knows, so strangers can't POST to /api/ingest.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SHREY_CLOUD_KEY=

# Optional: a shared passphrase to view the dashboard at all. Leave unset for an
# open dashboard (fine on a private network / behind your own auth already).
# Generate one the same way as above.
SHREY_VIEW_KEY=
